        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="if ((prac1_test_resp.keys === yes_key)) {&amp;#10;    prac_TestResp = &quot;old&quot;;&amp;#10;} else {&amp;#10;    if ((prac1_test_resp.keys === no_key)) {&amp;#10;        prac_TestResp = &quot;new&quot;;&amp;#10;        prac_typed_name = &quot;&quot;;&amp;#10;    }&amp;#10;}&amp;#10;psychoJS.experiment.addData(&quot;prac_TestResp&quot;, prac_TestResp);&amp;#10;practice_test_correct.push((prac_TestResp === &quot;new&quot;));&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="#Log response&amp;#10;&amp;#10;if prac1_test_resp.keys == yes_key:&amp;#10;    prac_TestResp = 'old'&amp;#10;elif prac1_test_resp.keys == no_key:&amp;#10;    prac_TestResp = 'new'&amp;#10;    prac_typed_name = &quot;&quot;&amp;#10;thisExp.addData('prac_TestResp', prac_TestResp)&amp;#10;        &amp;#10;&amp;#10;#add to all answers if correct&amp;#10;practice_test_correct.append(prac_TestResp == &quot;new&quot;)" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
