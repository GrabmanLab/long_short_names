        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="if ((prac_typed_name === &quot;idk&quot;)) {&amp;#10;    continueRoutine = false;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="if prac_typed_name == &quot;idk&quot;:&amp;#10;    continueRoutine = False" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="#Cont. only allowed after answering slider and pressing continue. &amp;#10;if prac_conf2_cont.isClicked and prac_conf2.getRating() is not None:&amp;#10;    continueRoutine = False" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="if ((prac_conf2_cont.isClicked &amp;&amp; (prac_conf2.getRating() !== null))) {&amp;#10;    continueRoutine = false;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="prac_feedback = &quot;&quot;;&amp;#10;if ((prac_TestResp === &quot;old&quot;)) {&amp;#10;    prac_feedback = &quot;I am sorry, that answer is incorrect. This face was never shown&quot;;&amp;#10;} else {&amp;#10;    if ((prac_TestResp === &quot;new&quot;)) {&amp;#10;        prac_feedback = &quot;Correct! You should not remember this face because it was not shown in the previous trials&quot;;&amp;#10;    }&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="prac_feedback = &quot;&quot;&amp;#10;&amp;#10;#show the following feedback depending on the participants answer.&amp;#10;if prac_TestResp == &quot;old&quot;:&amp;#10;    prac_feedback = &quot;I am sorry, that answer is incorrect. This face was never shown&quot;&amp;#10;elif prac_TestResp == &quot;new&quot;:&amp;#10;    prac_feedback = &quot;Correct! You should not remember this face because it was not shown in the previous trials&quot;" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="prac_conf2_code" valType="code" updates="None" name="name"/>
